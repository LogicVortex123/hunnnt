{
  "name": "opportunity-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:local": "turbo run dev --filter=@opportunityos/api --filter=@opportunityos/dashboard",
    "start:local": "turbo run serve --filter=@opportunityos/api --filter=@opportunityos/dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
